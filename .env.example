SENTINEL_ENVIRONMENT=development
SENTINEL_SECRET_KEY=replace-with-at-least-32-random-characters
SENTINEL_ANALYST_EMAIL=analyst@sentinel.local
SENTINEL_ANALYST_PASSWORD=replace-this-demo-password
# Optional alternative: SENTINEL_ANALYST_PASSWORD_HASH=pbkdf2_sha256$...
SENTINEL_SUPERVISOR_EMAIL=supervisor@sentinel.local
SENTINEL_SUPERVISOR_PASSWORD=replace-this-supervisor-password
# Optional alternative: SENTINEL_SUPERVISOR_PASSWORD_HASH=pbkdf2_sha256$...
SENTINEL_AUTH_MODE=required
SENTINEL_PERSISTENCE_MODE=hybrid
SENTINEL_CONNECTIVITY_MODE=hybrid
SENTINEL_AUDIT_ANCHOR_MODE=opentimestamps
SENTINEL_AUDIT_ANCHOR_DIR=backend/data/investigations/audit_anchors
SENTINEL_AUDIT_ANCHOR_CALENDARS=https://a.pool.opentimestamps.org,https://b.pool.opentimestamps.org
SENTINEL_AUDIT_ANCHOR_TIMEOUT_SECONDS=5
SENTINEL_AUDIT_ANCHOR_PUBLIC_LIMIT=3
SENTINEL_BITCOIN_HEADER_API=https://blockstream.info/api
SENTINEL_TOKEN_TTL_MINUTES=480
SENTINEL_RATE_LIMIT_PER_MINUTE=600
SENTINEL_MAX_INGESTION_RECORDS=100000
SENTINEL_MAX_INGESTION_COLUMNS=200
SENTINEL_MAX_CELL_CHARACTERS=20000
SENTINEL_UPLOAD_DIR=backend/data/uploads
SENTINEL_INVESTIGATION_DIR=backend/data/investigations
SENTINEL_AUDIT_PATH=backend/data/investigations/audit_chain.jsonl
SENTINEL_DECISIONS_PATH=backend/data/investigations/suraksha_resolution_decisions.json
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_NEO4J_URI=bolt://localhost:7687
SENTINEL_NEO4J_USER=neo4j
SENTINEL_NEO4J_PASSWORD=sentinel-password
SENTINEL_REDIS_URL=redis://localhost:6379/0
SENTINEL_ALLOWED_ORIGINS=http://localhost:5173
